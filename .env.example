# Anthropic API Key for Claude execution
# If unset or left empty, SurveyIQ automatically falls back to the deterministic local test agent (mock_llm.py)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# (Optional) Model name to use (defaults to claude-sonnet-4-5-20250929)
# Common options: claude-sonnet-4-5-20250929, claude-3-7-sonnet-20250219, claude-3-5-haiku-latest
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929


